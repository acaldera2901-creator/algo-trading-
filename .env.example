# ─── Anthropic (Claude AI) ───────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ─── Broker: OANDA ───────────────────────────────────────────────────────────
OANDA_API_KEY=your_oanda_api_key_here
OANDA_ACCOUNT_ID=your_oanda_account_id_here
OANDA_ENV=practice          # practice | live

# ─── Broker: MetaTrader 5 ────────────────────────────────────────────────────
MT5_LOGIN=your_mt5_login
MT5_PASSWORD=your_mt5_password
MT5_SERVER=your_mt5_server

# ─── Broker: MT5 Mac Bridge (MQL5 EA + HTTP) ─────────────────────────────────
# Install AlgoTradingBridge.mq5 in MT5 on Mac, set ServerIP to this machine's IP
EA_BRIDGE_PORT=8765         # port for the HTTP bridge server

# ─── Agent Settings ──────────────────────────────────────────────────────────
BROKER=ea_bridge            # oanda | mt5 | ea_bridge
DRY_RUN=true                # true = no real orders
LOG_LEVEL=INFO

# ─── Risk Management ─────────────────────────────────────────────────────────
RISK_PER_TRADE_PCT=1.0
MAX_DRAWDOWN_PCT=10.0
MAX_OPEN_POSITIONS=3
SL_MULTIPLIER=1.5
TP_MULTIPLIER=2.0
